# Keep CLI uploads lean — these are never needed for the Next.js build.
mcp/node_modules
remotion/node_modules
remotion/out
remotion/public/dir-*.mp3
remotion/public/dir-*.png
scripts/mockups
**/*.mp4
# ...but the site's own videos ARE served (home tour film, look samples, industry
# demos, the first-video pop-up). Without this every /public .mp4 was a 404.
!public/**/*.mp4
.git
