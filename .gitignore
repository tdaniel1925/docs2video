# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env.local
.env*.local
.env.production
.env*

# vercel
.vercel

# large media files (generated, can be recreated)
public/industry-demos/
public/music/
public/test-*.mp4
public/test-*.png
music/

# temp files
refs/

# scratch: copy/brief text dumps, sample PDFs, ad-hoc render + screenshot dumps
*-copy.txt
*-text.txt
*-brief.pdf
comprehension.json
motion-sample.mp4
pics/
demo-annuity.pdf

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

.vercel

# Playwright
test-results/
playwright-report/
video-service/start.sh

# Video service secrets
video-service/docker-compose.yml

# Demo/test media files
demo-*.mp4
test-overlay-*.png
vps-start-container.sh

# One-off VPS patch scripts (canonical server lives in vps/server.js)
vps-*.js
vps-*.py
vps-*.sh

# Generated teaser assets
teaser-output/

# Local design-template references (not app code)
_review/

# local secrets (platform key + internal secret, never commit)
*.tmp

# generated job payloads/bundles
vps/.job/
.logo-lab/
logo-lab/runs/
logo-lab/results.json
.logo-fix/
# one-off verification screenshots from smoke/check scripts
check-*.png
smoke-*.png
out-*.png

# Working data from the style split — the decisions themselves live in the
# engine (look, subject, mergedInto, mergedWhy), so these are the notebook and
# not the record.
.styles/
