{
  "family": "docs2video-service",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "8192",
  "executionRoleArn": "arn:aws:iam::423401347103:role/ecsTaskExecutionRole",
  "runtimePlatform": { "operatingSystemFamily": "LINUX", "cpuArchitecture": "X86_64" },
  "containerDefinitions": [
    {
      "name": "video-service",
      "image": "423401347103.dkr.ecr.us-east-1.amazonaws.com/docs2video-service:latest",
      "essential": true,
      "portMappings": [{ "containerPort": 4000, "protocol": "tcp" }],
      "linuxParameters": {
        "initProcessEnabled": true,
        "sharedMemorySize": 2048
      },
      "environment": [
        { "name": "PORT", "value": "4000" },
        { "name": "IMAGE_MODEL", "value": "gemini-3-pro-image-preview" },
        { "name": "REMOTION_AWS_REGION", "value": "us-east-1" }
      ],
      "secrets": [],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/docs2video-service",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "healthCheck": {
        "command": ["CMD-SHELL", "node -e \"fetch('http://localhost:4000/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))\""],
        "interval": 30,
        "timeout": 10,
        "retries": 3,
        "startPeriod": 120
      }
    }
  ]
}
