node_modules/
out/
build/
.remotion/

# Generated pipeline media (regenerated by scripts/*.mjs) — keep source, not artifacts
public/*.png
public/*.mp3
public/*.mp4
public/*.json
# Per-brand generated asset dirs (comic panels, VO, music) — regenerable via scripts/gen-*.
# Reference samples (Apex etc.) are not committed; the gen scripts + source are.
public/*/
# loose top-level media in public/ (superseded / brand-specific) — skip
public/*.wav
public/*.jpg
public/*.jpeg
public/*.wav

# BUT keep the shared, reusable SFX pack (used by TemplateCommercial for every brand)
!public/sfx/
public/sfx/*.png

# stray render/frame dumps at the remotion root
ca_*.png
ss_*.png
*.log
